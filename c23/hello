#!../c23sh -vv
// Executable C script using a shebang (in scripts use #!/usr/bin/env c23sh).
int main()
{
    // gcc-14 -std=gnu23 reports a draft version while gcc-15 returns final one
    printf("Hello, world from __STDC_VERSION__: %ld\n", __STDC_VERSION__);
    return __STDC_VERSION__ < 202000L || __STDC_VERSION__ > 202311L;
}
